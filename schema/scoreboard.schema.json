{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/braxtonmensah/silicyte-grader-wargame/schema/scoreboard.schema.json",
 "title": "Wargame scoreboard",
 "description": "Written only by .github/workflows/record.yml from CI verdicts.",
 "type": "object",
 "required": ["entries"],
 "additionalProperties": false,
 "properties": {
  "entries": {
   "type": "array",
   "items": {
    "type": "object",
    "required": ["handle", "level", "kind", "pr", "run_url", "utc", "maintainer_test"],
    "additionalProperties": false,
    "properties": {
     "handle": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"},
     "level": {"enum": ["L0", "L1", "L2", "L3", "L4", "L5", "L6"]},
     "kind": {"enum": ["exploit", "solve"]},
     "pr": {"type": "integer", "minimum": 1},
     "run_url": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/actions/runs/[0-9]+$"},
     "check_run_url": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/actions/runs/[0-9]+$"},
     "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
     "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
     "maintainer_test": {"type": "boolean"},
     "sgx_id": {"type": "string", "pattern": "^SGX-2026-[0-9]{3}$"}
    }
   }
  }
 }
}
